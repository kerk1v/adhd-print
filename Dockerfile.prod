# ADHD Print Task Management System - Production Dockerfile
# Optimized for production deployment with ASGI server

FROM python:3.13-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=adhd_print_project.settings

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libfreetype6-dev \
    libjpeg-dev \
    libpng-dev \
    libffi-dev \
    libssl-dev \
    fonts-dejavu-core \
    fonts-liberation \
    fontconfig \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get install -y git 

# Create application user
RUN useradd --create-home --shell /bin/bash --uid 1000 adhd_print

# Set work directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY --chown=adhd_print:adhd_print . .

# Create necessary directories with proper permissions
RUN mkdir -p /app/data /app/static /app/staticfiles /app/logs && \
    chown -R adhd_print:adhd_print /app && \
    chmod +x /app/start_asgi.sh

# Switch to non-root user
USER adhd_print

# Collect static files
RUN python manage.py collectstatic --noinput

# Run database migrations
RUN python manage.py migrate --noinput

# Health check for production
HEALTHCHECK --interval=60s --timeout=30s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/tasks/ || exit 1

# Expose port
EXPOSE 8000

# Use ASGI server for production
CMD ["./start_asgi.sh"]