# ADHD Print Environment Configuration
# Copy this file to .env and modify as needed

# Database Configuration
# ADHD_PRINT_DATA_DIR=/custom/path/to/data
# ADHD_PRINT_DB_NAME=custom_database.db

# Printer Configuration
# ADHD_PRINT_PRINTER_HOST=192.168.1.40
# ADHD_PRINT_PRINTER_PORT=9100
# ADHD_PRINT_USE_GRAPHICS=True

# Django Configuration (for production)
# SECRET_KEY=your-secret-key-here
# DEBUG=False
# ALLOWED_HOSTS=your-domain.com,localhost

# Email Configuration
# For Gmail/Google Workspace:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# For other SMTP providers:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=your-smtp-host.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-smtp-username
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# Development (console output only):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Account Settings
# ACCOUNT_ACTIVATION_DAYS=7