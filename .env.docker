# ADHD Print Docker Environment Configuration
# Copy this file to .env and modify as needed for Docker deployment

# === Django Production Settings ===
# IMPORTANT: Change SECRET_KEY for production!
SECRET_KEY=django-insecure-change-this-key-in-production-use-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,adhd.spainip.es

# === CSRF Configuration ===
# Add your domain(s) to prevent CSRF errors in production
CSRF_TRUSTED_ORIGINS=https://adhd.spainip.es,http://adhd.spainip.es

# === Database Configuration ===
ADHD_PRINT_DATA_DIR=/app/data
ADHD_PRINT_DB_NAME=adhd_print.db

# === Printer Configuration ===
# Set these to match your thermal printer network settings
ADHD_PRINT_PRINTER_HOST=192.168.1.40
ADHD_PRINT_PRINTER_PORT=9100
ADHD_PRINT_USE_GRAPHICS=True

# === Background Jobs ===
BACKGROUND_JOBS_ENABLED=True
MAINTENANCE_SCHEDULE_HOUR=2
MAINTENANCE_SCHEDULE_MINUTE=0

# === ASGI Server Settings ===
ASGI_HOST=0.0.0.0
ASGI_PORT=8000
ASGI_WORKERS=2
ASGI_LOG_LEVEL=info
ASGI_RELOAD=false

# === Python Settings ===
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# === Timezone ===
TZ=UTC
# Examples:
# TZ=America/New_York
# TZ=Europe/London
# TZ=Asia/Tokyo

# === Optional: External Database (PostgreSQL) ===
# Uncomment and configure for production with external database
# DATABASE_URL=postgresql://user:password@db:5432/adhd_print
# ADHD_PRINT_USE_POSTGRESQL=True

# === Optional: Redis (for future caching/sessions) ===
# REDIS_URL=redis://redis:6379/0

# === Optional: Email Configuration (for notifications) ===
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password