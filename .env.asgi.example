# ASGI Configuration for ADHD Print Task Management
# Copy this file to .env and modify as needed

# Server Configuration
ASGI_HOST=127.0.0.1
ASGI_PORT=8000
ASGI_WORKERS=1
ASGI_LOG_LEVEL=info
ASGI_RELOAD=false

# Django Settings
DJANGO_SETTINGS_MODULE=adhd_print_project.settings
DJANGO_SECRET_KEY=your-secret-key-here

# Database Configuration (if using external database)
# DATABASE_URL=sqlite:///./data/adhd_print.db

# Data Directory
ADHD_PRINT_DATA_DIR=./data

# Production Settings
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Background Jobs
BACKGROUND_JOBS_ENABLED=true
MAINTENANCE_SCHEDULE_HOUR=2
MAINTENANCE_SCHEDULE_MINUTE=0

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs