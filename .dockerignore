# ADHD Print Task Management System - Docker Ignore
# Exclude files that shouldn't be copied to Docker image

# Version control
.git
.gitignore
.gitattributes

# Documentation
*.md
docs/
*.rst

# Development files
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environment
venv/
env/
ENV/
.venv/

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/
test_*.py
*_test.py
validate_tests.py

# Environment files
.env*
.envrc

# OS specific
.DS_Store
.DS_Store?
._*
Thumbs.db

# Temporary files
*.tmp
*.log
*.pid
*.sock
logs/

# Printer test files
*.escpos
test_*.png
quick_*.png
bitmap_test.*
line_test.*
text_test.*

# Docker files (don't copy into image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Data directory (mounted as volume)
data/

# Static files (generated in container)
staticfiles/
# Note: Keep static/ directory as it contains fonts and other assets

# Development scripts
run_tests.sh
test_*.sh
scripts/

# Backup files
*.backup
*.bak
*.orig